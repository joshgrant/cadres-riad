{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cadres Riad",
  "version": "0.5.0",
  "identifier": "com.joshgrant.cadresriad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadres Riad",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "Photography",
    "shortDescription": "Encadrez vos photos",
    "copyright": "© 2026 Joshua Grant — AGPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQkQzQzMzN0IwN0QzOTYKUldTVzB3ZDdNenk5NC83T3NXVXBKbks4dGE1eXgxTEQraDNEaWZoN3Jsdmo2V2MxblVjT29QdmsK",
      "endpoints": [
        "https://github.com/joshgrant/cadres-riad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
